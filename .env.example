DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="your-unsigned-preset"
ADMIN_PASSWORD="choose-a-shared-admin-password"
# Optional but recommended for production: a separate high-entropy secret
# used to sign admin session cookies. If unset, falls back to
# ADMIN_PASSWORD (fine for local/demo use, not recommended for production).
# Uncomment and set a real value before deploying:
# SESSION_SECRET="choose-a-separate-high-entropy-secret"
