generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  collection  String
  price       Int
  imageUrl    String
  description String   @default("")
  createdAt   DateTime @default(now())
}

model Order {
  id           String      @id @default(cuid())
  name         String
  email        String
  phone        String?
  addressLine1 String
  addressLine2 String?
  city         String
  region       String
  postalCode   String
  country      String
  total        Int
  createdAt    DateTime    @default(now())
  items        OrderItem[]
}

model OrderItem {
  id          String @id @default(cuid())
  orderId     String
  order       Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  productName String
  price       Int
  quantity    Int
}

model BespokeInquiry {
  id                  String   @id @default(cuid())
  name                String
  email               String
  description         String
  inspirationImageUrl String?
  createdAt           DateTime @default(now())
}

model SourcingInquiry {
  id          String   @id @default(cuid())
  name        String
  email       String
  buyerType   String
  companyName String?
  interest    String
  details     String
  createdAt   DateTime @default(now())
}
