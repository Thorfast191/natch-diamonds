generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id         String   @id @default(cuid())
  name       String
  collection String
  price      Int
  imageUrl   String
  createdAt  DateTime @default(now())
}

model BespokeInquiry {
  id                  String   @id @default(cuid())
  name                String
  email               String
  description         String
  inspirationImageUrl String?
  createdAt           DateTime @default(now())
}

model SourcingInquiry {
  id          String   @id @default(cuid())
  name        String
  email       String
  buyerType   String
  companyName String?
  interest    String
  details     String
  createdAt   DateTime @default(now())
}
